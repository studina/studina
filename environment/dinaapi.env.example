# Proveedor y modelo de chat. Valores de AI_CHAT_PROVIDER: google-genai, ollama.
AI_CHAT_PROVIDER=google-genai
AI_CHAT_MODEL=gemini-2.5-flash
# Opcionales. Si se dejan iguales, toda la aplicación usa AI_CHAT_MODEL.
AI_GENERATION_MODEL=gemini-2.5-flash
AI_CLASSIFICATION_MODEL=gemini-2.5-flash
AI_SUMMARY_MODEL=gemini-2.5-flash
AI_CHAT_TEMPERATURE=0.2

# Gemini sigue siendo necesario para embeddings aunque el chat use Ollama.
GEMINI_API_KEY=api_key_gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Sólo se utiliza cuando AI_CHAT_PROVIDER=ollama.
# Desde Docker, host.docker.internal apunta al Ollama instalado en el host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_DB_URL=jdbc:postgresql://localhost:5433/studina_rag
RAG_DB_USERNAME=studina
RAG_DB_PASSWORD=studina123
MODEL_ARMOR_URL=https://modelarmor.<model_armor_region>.rep.googleapis.com
MODEL_ARMOR_API_KEY=model_armor_api_key
MODEL_ARMOR_PROJECT_ID=nombre_proyecto
MODEL_ARMOR_LOCATION=region
MODEL_ARMOR_TEMPLATE_ID=nombre_template
MODEL_ARMOR_ENABLED=true
DIRECTUS_URL=http://localhost:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=admin123456
DIRECTUS_ROLE_NAME=Studina User
