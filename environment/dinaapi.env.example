# Proveedor y modelo de chat. Valores: google-genai, ollama, openai.
AI_CHAT_PROVIDER=google-genai
AI_CHAT_MODEL=gemini-2.5-flash
# Opcionales. Si se dejan iguales, toda la aplicación usa AI_CHAT_MODEL.
AI_GENERATION_MODEL=gemini-2.5-flash
AI_CLASSIFICATION_MODEL=gemini-2.5-flash
AI_SUMMARY_MODEL=gemini-2.5-flash
AI_CHAT_TEMPERATURE=0.2

# Gemini sigue siendo necesario para embeddings aunque el chat use Ollama.
# Requerido para embeddings. Crear la clave en Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Se utiliza cuando el proveedor general o el del usuario es Ollama.
# Desde Docker, host.docker.internal apunta al Ollama instalado en el host.
# compose.ollama.yaml reemplaza esta URL por http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Espera máxima por solicitud de inferencia. 600 segundos = 10 minutos.
OLLAMA_READ_TIMEOUT_SECONDS=600

# Sólo son necesarios si el servidor usa OpenAI como proveedor por defecto.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Generar una propia con: openssl rand -base64 32
# Es necesaria para guardar de forma segura las API keys aportadas por usuarios.
AI_CREDENTIALS_ENCRYPTION_KEY=

# Dentro de Docker se usan el nombre del servicio y su puerto interno.
RAG_DB_URL=jdbc:postgresql://pgvector:5432/studina_rag
RAG_DB_USERNAME=studina
RAG_DB_PASSWORD=studina123

# Opcional. Si se habilita, requiere Application Default Credentials de gcloud.
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=

DIRECTUS_URL=http://directus:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=admin123456
DIRECTUS_ROLE_NAME=Studina User
