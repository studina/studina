# Proveedor y modelo generales de chat: google-genai u ollama.
AI_CHAT_PROVIDER=google-genai
# Proveedores disponibles en Mi perfil y durante la ejecución.
AI_ALLOWED_PROVIDERS=google-genai,ollama,openai
AI_CHAT_MODEL=gemini-3.5-flash-lite
# Opcionales. Si se dejan iguales, toda la aplicación usa AI_CHAT_MODEL.
AI_GENERATION_MODEL=gemini-3.5-flash-lite
AI_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
AI_SUMMARY_MODEL=gemini-3.5-flash-lite
AI_CHAT_TEMPERATURE=0.2
# Presupuesto total para generar recursos con Gemini/OpenAI, incluidos reintentos.
AI_GENERATION_TIMEOUT_MS=120000

# Gemini sigue siendo necesario para embeddings aunque el chat use Ollama.
# Requerido para embeddings. Crear la clave en Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Se utiliza cuando el proveedor general o el del usuario es Ollama.
# Servidor del perfil `ollama` de Compose, accesible por la red interna.
# Para Ollama instalado en el host: http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
# Espera máxima por solicitud de inferencia. 600 segundos = 10 minutos.
OLLAMA_READ_TIMEOUT_SECONDS=600
# Una inferencia activa; hasta dos solicitudes adicionales esperan como máximo 10 minutos.
OLLAMA_QUEUE_TIMEOUT_SECONDS=600
OLLAMA_MAX_QUEUED_REQUESTS=2
OLLAMA_NUM_THREADS=4

# OpenAI usa la API key personal configurada por cada usuario en Mi perfil.
# El servidor define el endpoint de OpenAI o del servicio compatible.
OPENAI_BASE_URL=https://api.openai.com/v1

# Generar una propia con: openssl rand -base64 32
# Es necesaria para guardar de forma segura las API keys aportadas por usuarios.
AI_CREDENTIALS_ENCRYPTION_KEY=

# Dentro de Docker se usan el nombre del servicio y su puerto interno.
RAG_DB_URL=jdbc:postgresql://pgvector:5432/studina_rag
RAG_DB_USERNAME=studina
RAG_DB_PASSWORD=studina123

# Opcional. Si se habilita, requiere Application Default Credentials de gcloud.
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=
# Ruta absoluta en el host, fuera del repo; sólo se monta con el overlay opcional.
MODEL_ARMOR_CREDENTIALS_FILE=
# El overlay fija esta variable a la ruta dentro del contenedor.
GOOGLE_APPLICATION_CREDENTIALS=

DIRECTUS_URL=http://directus:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=admin123456
DIRECTUS_ROLE_NAME=Studina User
