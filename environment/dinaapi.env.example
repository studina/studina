# Requerido. Crear la clave en Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Dentro de Docker se usan el nombre del servicio y su puerto interno.
RAG_DB_URL=jdbc:postgresql://pgvector:5432/studina_rag
RAG_DB_USERNAME=studina
RAG_DB_PASSWORD=studina123

# Opcional. Si se habilita, requiere Application Default Credentials de gcloud.
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_TEMPLATE_ID=

DIRECTUS_URL=http://directus:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=admin123456
DIRECTUS_ROLE_NAME=Studina User
