# Generar con: openssl rand -hex 32
SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_URL=http://localhost:8055

# Base PostgreSQL del servicio "postgres" de compose.yaml.
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studina_core
DB_USER=studina
DB_PASSWORD=studina123

# Credenciales del administrador inicial y de la API interna.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
