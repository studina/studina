{
	email {$ACME_EMAIL}
	# Browsers connecting to an IP may omit SNI; Docker sees its private container IP.
	default_sni {$STUDINA_DEFAULT_SNI}
}

# Container health only; this listener is not published by Compose.
http://:8080 {
	bind 127.0.0.1
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}

{$STUDINA_DOMAIN} {$STUDINA_PUBLIC_IP} {
	# IP certificates require Let's Encrypt's six-day profile; renew automatically.
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}

	encode zstd gzip

	# Leave room for multipart framing above Spring's 50 MB upload limit.
	request_body {
		max_size 55MB
	}

	# Preserve this order so private routes are rejected before proxying or SPA fallback.
	route {
		@privateActuator {
			path /api/actuator /api/actuator/*
			not path /api/actuator/health /api/actuator/health/readiness /api/actuator/health/liveness
		}
		respond @privateActuator 404
		respond /api 404

		# Match the development proxy: the API receives /auth, /chat, etc.
		# Cookie paths remain /api/auth on the browser-facing origin.
		handle_path /api/* {
			reverse_proxy dina-api:9000 {
				flush_interval -1
				transport http {
					dial_timeout 10s
					response_header_timeout 10m
					read_timeout 10m
					write_timeout 10m
				}
			}
		}

		# Vite fingerprints these filenames, so they can be cached for a year.
		handle /assets/* {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# React routes fall back to the current index instead of returning a 404.
		handle {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
