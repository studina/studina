# Crear con scripts/aws/setup-env.sh. El archivo real .env queda fuera de Git.
# Usar sólo el hostname, sin https://, rutas ni puerto; DNS A hacia la IP de la VM.
STUDINA_DOMAIN=studina.example.com
# Opcional: IPv4 pública fija para acceso HTTPS adicional sin depender de DNS.
STUDINA_PUBLIC_IP=
ACME_EMAIL=replace-me@example.com

# Gemini general y embeddings consumen la cuenta del equipo.
# OpenAI se configura con API key personal desde Mi perfil.
GEMINI_API_KEY=replace-me
AI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Generados por setup-env.sh. Conservarlos junto con los backups.
AI_CREDENTIALS_ENCRYPTION_KEY=replace-me
DIRECTUS_SECRET=replace-me
DIRECTUS_ADMIN_EMAIL=replace-me@example.com
DIRECTUS_ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
RAG_DB_PASSWORD=replace-me
